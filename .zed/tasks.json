[
  {
    "label": "publish literateHtml",
    "command": "watchexec",
    "args": [
      "--exts", "lean", "-r",
      "\"rm -fr .lake/build/literate; lake build; lake build :literateHtml; lake exe verso-serve .lake/build/literate-html\""
